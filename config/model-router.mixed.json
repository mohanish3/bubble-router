{
  "schema_version": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 8090,
    "upstream_base_url": "http://127.0.0.1:8080",
    "api_key_env": "MODEL_ROUTER_API_KEY",
    "default_api_key": "",
    "warm_model": "gemma",
    "ready_timeout_seconds": 180,
    "stop_timeout_seconds": 10,
    "queue_warning_depth": 8,
    "max_loaded_jobs": 4,
    "max_loaded_seconds": 30,
    "llm_classify": false,
    "llm_classify_timeout": 2.0
  },
  "classifier": {
    "model": "cross-encoder/nli-MiniLM2-L6-H768",
    "confidence_threshold": 0.55,
    "labels": {
      "gemma":     "general reasoning, ordinary questions, planning, or tool use",
      "qwen-opus": "complex multi-step reasoning, difficult analysis, proofs, or deep research",
      "claude":    "software engineering, coding, debugging, code review, or repository work"
    }
  },
  "binary_candidates": ["llama-server"],
  "aliases": {
    "auto":             "auto",
    "general":          "gemma",
    "complex-reasoning":"qwen-opus",
    "coding":           "claude"
  },
  "models": {
    "gemma": {
      "backend":    "llamacpp",
      "public_id":  "unsloth/gemma-4-12b-it-GGUF:Q5_K_M",
      "model_path": "/path/to/your-models/gemma-4-12b-it-Q5_K_M.gguf",
      "context_size": 131072,
      "max_predict": 16184,
      "extra_args": ["--no-mmproj"]
    },
    "qwen-opus": {
      "backend":    "ollama",
      "public_id":  "qwen2.5:7b",
      "model_id":   "qwen2.5:7b",
      "base_url":   "http://127.0.0.1:11434"
    },
    "claude": {
      "backend":     "claude",
      "public_id":   "claude-sonnet-4-6",
      "model_id":    "claude-sonnet-4-6",
      "provider":    "claude",
      "api_key_env": "ANTHROPIC_API_KEY"
    }
  },
  "common_args": []
}
